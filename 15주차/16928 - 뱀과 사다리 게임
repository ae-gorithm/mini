#include <iostream>
#include <vector>
#include <algorithm>
#include <string>
#include <queue>
#include <stack>
#include <cmath>
#include <map>
#include <climits>

using namespace std;

int arr[101] = { 0, };
int d[101] = { 0, };
int n, m;


int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    cout.tie(NULL);

    cin >> n >> m;

    int n1, n2;
    for (int i = 0; i < n; i++) {
        cin >> n1 >> n2;
        arr[n1] = n2;
    }
    for (int i = 0; i < m; i++) {
        cin >> n1 >> n2;
        arr[n1] = n2;
    }

    for (int i = 0; i < 101; i++) {
        d[i] = -1;
    }

    queue<int> q;
    q.push(1);
    d[1] = 0;

    while (!q.empty()) {
        int x = q.front(); q.pop();

        for (int i = 1; i <= 6; i++) {
            int nx = x + i;
            if (nx > 100) continue;

            if (arr[nx] != 0) {
                nx = arr[nx]; // 사다리나 뱀이 있으면 이동
            }

            if (d[nx] == -1) {
                d[nx] = d[x] + 1;
                q.push(nx);
            }
        }
    }

    cout << d[100] << '\n';
    return 0;
}
