using namespace std;

int dp[101] = { 0, };
int hp[21];
int happy[21];

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    cout.tie(NULL);

    int n, k;
    cin >> k >> n;
    int max = 0;
    vector<int> arr(k);
    
    for (int i = 0; i < k; i++) {
        cin >> arr[i];
        if (max < arr[i]) {
            max = arr[i];
        }
    }

    long long int low = 1;
    long long int high = max;
    long long int result = 0;

    while (low <= high) {
        long long int mid = (low + high) / 2;
        int sum = 0;
        for (int i = 0; i < k; i++) {
            sum += arr[i] / mid;
        }
        
        if (sum < n) {
            high = mid - 1;
        }

        else if (sum >= n) {
            low = mid + 1;
            result = mid;
        }

    }

    cout << result;

    

    return 0;
}
