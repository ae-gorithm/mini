#include <iostream>
#include <vector>
#include <algorithm>
#include <string>
#include <queue>
#include <stack>
#include <cmath>
#include <map>
#include <climits>

using namespace std;


int main(){
    int n;
    cin >> n;
    vector<pair<int, int>> arr(n + 1);
    int dp[100] = { 0, };

    //for (int i = 1; i <= n; i++) {
    //    int a, b;
    //    cin >> a >> b;

    //    arr.push_back(make_pair(a, b));
    //}

    for (int i = 1; i <= n; i++) {
        cin >> arr[i].first >> arr[i].second;
    }

    for (int i = n; i >= 1; i--) {
        int day = i + arr[i].first;
        if (day > n + 1) { // 상담을 확정적으로 못하는 날이라 전 날 까지의 최대값을 그냥 가져옴
            dp[i] = dp[i + 1];
        }
        else { // 상담이 가능한 날임
            // (이때는 전 날까지 일해서 번 돈의 최대치 vs 해당 날짜에 일해서 벌 수 있는 돈 + 해당 날짜에 걸리는 시간(일 수)전 까지 벌었던 돈의 최대치)
            dp[i] = max(dp[i + 1], arr[i].second + dp[day]);
        }
    }

    cout << dp[1];
    return 0;
}
