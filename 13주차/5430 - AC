#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <time.h>
#include <stdlib.h>
#include <math.h>
#include <string.h>

char cmd[200000];
char str[400001];
int arr[200000];

int main() {
	int t, n;
	scanf("%d", &t);

	for (int i = 0; i < t; i++) {
		int m = 0;
		scanf("%s", cmd);
		scanf("%d", &n);
		getchar();
		scanf("%s", str);

		int len = strlen(str);
		int tmp = 0;
		for (int j = 0; j < len; j++) {
			if (str[j] == ',' || str[j] == ']') { // int 형 arr 배열에 숫자를 넣어줌
				if (tmp > 0) {
					arr[m++] = tmp;
				}
				tmp = 0;
			}
			else if (str[j] >= '0' && str[j] <= '9') { // 숫자가 2자리 이상인 경우 [1,25,...]
				tmp *= 10;
				tmp += (str[j] - '0');
			}
		}

		int start = 0;
		int end = m - 1;
		int flag = 0;
		int flag2 = 0;

		for (int j = 0; j < strlen(cmd); j++) { 
			if (cmd[j] == 'R') { // 리버스 플래그 설정
				if (flag == 0) {
					flag = 1;
				}
				else if (flag == 1) {
					flag = 0;
				}
			}
			if (cmd[j] == 'D') {
				if (start > end) { // 에러가 난 경우 (배열안에 요소가 없는데 D연산을 했음)
					printf("error");
					flag2 = 1;
					break;
				}
				if (flag == 0) { // 정방향이면 앞에서 지우고
					start++;
				}
				else if (flag == 1) { // 리버스면 뒤에서 지움
					end--;
				}
			}
		}
		//printf("[start = %d end = %d flag2 = %d]", start, end, flag2);
		if (flag2 == 0) { // 만약 에러 안떴는데 
			if (start == end + 1) { // start가 end + 1이랑 같으면 다 지워진거
				printf("[]");
			}
		}
		if (start < end + 1 && flag2 != 1) { // 아니라면
			if (flag == 0) { // 마지막 커멘드가 리버스가 아니라면 정방향 출력
				printf("[");
				for (int j = start; j <= end; j++) {
					printf("%d", arr[j]);
					if (j < end) {
						printf(",");
					}
				}
				printf("]");
			}
			else { // 마지막 커멘드가 리버스라면 역방향 출력
				printf("[");
				for (int j = end; j >= start; j--) {
					printf("%d", arr[j]);
					if (j > start) {
						printf(",");
					}
				}
				printf("]");
			}
		}
		printf("\n");
	}
	return 0;
}

